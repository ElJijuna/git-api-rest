# Repo config
REPOS_CONFIG_PATH=./repos.yml
# REPOS=[{"key":"MYPROJECT","repo":"my-repo","url":"https://github.com/org/my-repo.git","branch":"main"}]
CLONE_BASE_PATH=./cloned-repos
GIT_PULL_INTERVAL=60

# Bitbucket Datacenter (optional — enables auto URL + SSL cert + known_hosts setup)
# BITBUCKET_SERVER_HOST=https://bitbucket.example.com
# BITBUCKET_USER=your-username
# BITBUCKET_TOKEN=your-api-token
# GIT_CLONE_PROTOCOL=ssh
# BITBUCKET_SSH_PORT=7999

# Per-repo HTTPS token override (alternative to auth.token in repos.yml)
# Pattern: AUTH_TOKEN_<KEY>_<REPO>  (uppercase, hyphens → underscores)
# AUTH_TOKEN_OTHER_PRIVATEREPO=ghp_xxxxxxxxxxxx

# Git commit identity (used for local git config after clone)
# GIT_USER_NAME=git-api-rest
# GIT_USER_EMAIL=git-api-rest@localhost

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Docker volume — SSH key path (mounted as /root/.ssh in container)
# SSH_KEY_PATH=~/.ssh
